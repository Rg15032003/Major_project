<style>
  .search-btn {
    position: relative;
    right: -3rem;
    background-color: #f90c1c;
    color: #fff;
    border-radius: 25px;
  }
  .search-btn:hover {
    background-color: #fe424d;
    color: #fff;
  }
  .search-btn i {
    display: inline;
    padding-left: .5rem;
     transition: transform 0.3s ease-in;
  }
  .search-btn:hover {
    transform: scale(1.1);
  }
  .search-inp {
    position: relative;
    right: -2rem;
    border-radius: 25px;
    padding: .5rem 3rem .5rem 3rem
  }
  .navbar {
  transition: backdrop-filter 0.3s ease, background-color 0.3s ease;
}

.navbar.scrolled {
  backdrop-filter: blur(8px);  
  background-color: rgba(255, 255, 255, 0.7) !important; 
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1); 
}

.navbar-brand .fa-compass {
  display: inline-block;
  animation: rotatePause 2s linear infinite;
}

@keyframes rotatePause {
  0% { transform: rotate(0deg); }
  40% { transform: rotate(360deg); } /* fast spin */
  70% { transform: rotate(360deg); } /* pause for 0.4s (approx) */
  100% { transform: rotate(720deg); } /* next fast spin */
}

.navbar-nav .nav-link.logout-link {
  border: 2px solid #f90c1c;  /* outline color */
  border-radius: 20px;
  padding: 6px 14px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2); /* subtle shadow */
  transition: all 0.3s ease-in-out;
}

.navbar-nav .nav-link.logout-link:hover {
  background-color: #f90c1c;
  color: #fff;
  box-shadow: 0 6px 10px rgba(0, 0, 0, 0.3); /* deeper shadow on hover */
}




</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-solid fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings"><b style="font-weight: 500;">Explore</b></a>
      </div>

      <form class="navbar-nav ms-auto" role="search">
        <input id="searchInput" class="form-control me-2 search-inp" type="search" placeholder="" />
        <button class="btn search-btn" type="submit">
          Search<i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
      
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new"><i style="font-family:Poppins; margin-right: 1rem;">Create new listing</i></a>
        <% if(!curruser) {%>
          <a class="nav-link " aria-current="page" style="font-family: Roboto;" href="/signup"><b>Sign in</b></a>
          <a class="nav-link" style="font-family: Roboto;" href="/login"><b>Login</b></a>
          <%}%>
            <%if(curruser) {%>
              <a class="nav-link logout-link" href="/logout">Logout</a>
              <%}%>

      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const input = document.getElementById("searchInput");
    const text = "Search Destinations";
    let i = 0;

    function typeEffect() {
      if (i < text.length) {
        input.setAttribute("placeholder", text.substring(0, i + 1));
        i++;
        setTimeout(typeEffect, 120); // typing speed
      }
    }

    typeEffect();
  });
  document.addEventListener("scroll", function () {
  const navbar = document.querySelector(".navbar");
  if (window.scrollY > 50) { 
    navbar.classList.add("scrolled");
  } else {
    navbar.classList.remove("scrolled");
  }
});

</script>